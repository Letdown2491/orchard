# orchard-indexd, hosted (no client): the catalog document and every
# protocol surface in front of it, including the flatpak OCI remote
# surface (/index/static + /v2 proxy). Install as a user unit (or a
# system unit with User=); adjust paths and flags per deployment.
#
#   flatpak remote-add --if-not-exists orchard \
#     oci+https://index.example.com
#
# Hosting notes (from the apps.orchard.rocks deployment, 2026-11-20):
# - The daemon starts with an empty catalog if no file exists: the
#   relays are the source of truth and verified events merge over the
#   base within seconds of startup. No seed file is needed.
# - Ship a static binary (musl): cargo build -p orchard-indexd
#   --target x86_64-unknown-linux-musl with musl-gcc as the target CC.
# - Reverse-proxy a dedicated subdomain (not a subpath) with TLS and
#   response buffering off; Caddy's `reverse_proxy` + flush_interval -1
#   is the whole config. DNS must resolve before the proxy first
#   starts, or Caddy downgrades the host to HTTP-only until reloaded.
# - On a small box (1 GB RAM), add a 1 GB swapfile; indexd idles at
#   ~15 MB RSS but a first-sync burst is worth insuring against.
#
# Unit file install (user):
#   mkdir -p ~/.config/systemd/user
#   cp packaging/systemd/orchard-indexd.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now orchard-indexd

[Unit]
Description=Orchard index daemon (catalog and flatpak OCI remote)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/orchard-indexd --listen 127.0.0.1:7780
# Relays to subscribe to (beats settings.json; --relays sets it here).
Environment=ORCHARD_RELAYS=wss://relay.example.com
# Hosted-only: the externally-visible base URL (the reverse proxy's
# https:// host) that /index/static names as Registry. Leave unset for
# a loopback-only daemon serving the local client.
#Environment=ORCHARD_PUBLIC_URL=https://index.example.com
Restart=on-failure
RestartSec=5s
# A local daemon carries no secrets; harden anyway.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
