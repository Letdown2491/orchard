# The Alpine apk (orchard issue #1): musl is a first-class ship target
# beside the deb/rpm/flatpak. Built through packaging/build-apk.sh
# (abuild refuses root, and the toolchain is rustup's stable: alpine
# 3.22's system cargo 1.87 is below the lock's MSRV), never by hand.
#
# Trust model: the CI build signs with the persistent APK_SIGN_PRIVATE_KEY
# secret, so one keypair signs every release on both architectures.
# Trust the shipped .pub once and every future version verifies clean;
# local builds without the secret fall back to a throwaway per-build key
# (install with --allow-untrusted).

pkgname=orchard
pkgver=0.5.0
pkgrel=0
pkgdesc="The permissionless Flatpak store: publishers sign, the catalog is a Nostr feed, every artifact is digest-pinned"
url="https://github.com/Letdown2491/orchard"
arch="x86_64 aarch64"
license="MIT"
# The linked libs (libxkbcommon, libxkbcommon-x11, libxcb, libXau) come
# in automatically: apk scans the binary's DT_NEEDED. The dlopened set
# does not (ldd cannot see it): wayland-client and the vulkan loader are
# opened at run time by gpui (strace, 2026-11-20), so they are named here.
depends="wayland vulkan-loader"
makedepends="pkgconfig fontconfig-dev freetype-dev libxkbcommon-dev
	wayland-dev vulkan-headers libxcb-dev clang"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
# GitHub's tag tarball extracts to orchard-<ver> (no v).
builddir="$srcdir/$pkgname-$pkgver"

# The toolchain is rustup's stable, installed for the builder user by
# packaging/build-apk.sh: alpine 3.22's system cargo (1.87) is below
# the lockfile's MSRV. Top-level so every abuild phase sees it.
export PATH="$HOME/.cargo/bin:$PATH"

# The musl target defaults to crt-static (a static-pie link), which
# demands a static archive for every C library: glib, xcb, freetype,
# xkbcommon, and alpine ships those shared only. Drop crt-static: the
# binary links dynamically against musl and the C libs, the normal
# shape for a shipped alpine package.
export RUSTFLAGS="-C target-feature=-crt-static"

build() {
	cargo build --release --locked -p orchard
}

check() {
	# The domain layer's suite: no display, no sockets, minutes-fast.
	cargo test --locked -p orchard-core
}

package() {
	install -Dm755 target/release/orchard \
		"$pkgdir"/usr/bin/orchard
	install -Dm644 packaging/rocks.orchard.Orchard.desktop \
		"$pkgdir"/usr/share/applications/rocks.orchard.Orchard.desktop
	install -Dm644 packaging/rocks.orchard.Orchard.metainfo.xml \
		"$pkgdir"/usr/share/metainfo/rocks.orchard.Orchard.metainfo.xml
	install -Dm644 assets/orchard-512.png \
		"$pkgdir"/usr/share/icons/hicolor/512x512/apps/rocks.orchard.Orchard.png
	install -Dm644 assets/orchard-128.png \
		"$pkgdir"/usr/share/icons/hicolor/128x128/apps/rocks.orchard.Orchard.png
}
